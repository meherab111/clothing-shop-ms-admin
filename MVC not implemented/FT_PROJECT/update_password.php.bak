<?php
$oldpassword = $newpassword  = $conpassword = "";
$oldpasswordErr = $newpasswordErr = $conpasswordErr = "";

//Name 
if ($_SERVER['REQUEST_METHOD'] === "POST") 

{
    $flag = false;


// Password & Confirm Password

	    if (empty($_POST["oldpassword"])) {
        $oldpasswordErr = "*Old Password is required";
        $flag = true;
    } else {
        $oldpassword = sanitize($_POST["oldpassword"]);
		
		 if (!preg_match("/^.{8,}$/", $oldpassword))
		{
            $oldpasswordErr = "*At least 8 characters required";
            $flag = true;
        }

    }


    if (empty($_POST["newpassword"])) {
        $newpasswordErr = "*New Password is required";
        $flag = true;
    } else {
        $newpassword = sanitize($_POST["newpassword"]);
		
		 if (!preg_match("/^.{8,}$/", $newpassword))
		{
            $newpasswordErr = "*At least 8 characters required";
            $flag = true;
        }

    }

    if (empty($_POST["conpassword"])) {
        $conpasswordErr = "*Confirm Password is required";
        $flag = true;
    } else {
        $conpassword = sanitize($_POST["conpassword"]);
    }

    if ($_POST["newpassword"] != $_POST["conpassword"]) {
        $conpasswordErr = "*Passwords doesn't match";
        $flag = true;
    }
	
	



    if ($flag === false) 
	{
		$id_update = $fetch['id'];
		
		include "db.php";
	
			

				$get_pass = "SELECT * FROM registered WHERE id = '$id_update'";
				
				$pass_query = mysqli_query($conn, $get_pass);
				
				$arr_pass = mysqli_fetch_array($pass_query);
				
				$db_pass = $arr_pass['password'];
				
				$pass_decode = password_verify($oldpassword,$db_pass );
				
				
			if ($oldpassword == $pass_decode)
			{
				if($newpassword == $conpassword)
				{
					$hash_newPassword = password_hash($newpassword,PASSWORD_BCRYPT);
					$update_pass = "UPDATE registered SET password='$hash_newPassword' WHERE id = '$id_update'";
					
					$update_pass_query = mysqli_query($conn, $update_pass);
					
					echo "<center>Password Updated Succesfully.</center>";
				}
				
				else
				{
					echo "<center>New password and confirm password doesn't match.</center>";
				}
	
				
					
			}
			else 	
			{
				echo "<center>Old Password doesn't match.</center>";
			}
		
	
			

	}
	

    
}

function sanitize($data) {
    $data = trim($data);
    $data = stripslashes($data);
    $data = htmlspecialchars($data);
    return $data;
}
